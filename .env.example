# IP-SAKTI Sahayak Environment Configuration

# Server Settings
PORT=8080
ALLOWED_ORIGINS=*

# Database Connection (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ipsakti
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipsakti?sslmode=disable

# AI & LLM Providers (mock, openai, gemini)
LLM_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_API_KEY=

# Innovator Trade Secret Protection (Zero-Data-Retention)
ZERO_DATA_RETENTION=true
