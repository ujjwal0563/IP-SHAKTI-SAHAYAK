# IP-SAKTI Sahayak Environment Configuration
# Copy this file to .env and fill in your values

# -------------------------
# HTTP Server Configuration
# -------------------------
PORT=8080
ALLOWED_ORIGINS=*

# -------------------------
# Database Configuration
# -------------------------
# Required: PostgreSQL 16 connection string (with pgvector installed)
# When running via docker-compose, this defaults to postgres://postgres:postgres@postgres:5432/ipsakti
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipsakti?sslmode=disable

# -------------------------
# LLM Integration
# -------------------------
# Options: "gemini", "openai", or "mock" (offline default)
LLM_PROVIDER=mock

# Provide the corresponding API key if using "gemini" or "openai"
# LLM_API_KEY=your-api-key-here
# EMBEDDING_API_KEY=your-api-key-here

# -------------------------
# Privacy & Security
# -------------------------
# true: Does not persist conversations to the database (Ephemeral Mode)
# false: Persists conversation history for multi-turn context
ZERO_DATA_RETENTION=true
